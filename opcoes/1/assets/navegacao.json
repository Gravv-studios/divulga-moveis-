{"comercio": {"union": ["gondolas", "acessorios-gondolas", "racks-checkouts", "balcoes-comerciais", "carrinhos", "cestos"]}, "gondolas-parede": {"parent": "gondolas", "pattern": "parede"}, "gondolas-centro": {"parent": "gondolas", "pattern": "centro"}, "gondolas-pontas": {"parent": "gondolas", "pattern": "ponta|canto"}, "mini-porta-paletes": {"parent": "armazenagem", "pattern": "^mini porta"}, "porta-paletes-industrial": {"parent": "armazenagem", "pattern": "^porta pallet industrial"}, "componentes-armazenagem": {"parent": "armazenagem", "pattern": "^bandeja|^longarina"}, "cadeiras": {"categories": ["cadeiras"], "exclude": "^(mesa|armario|banco|banqueta)"}, "cadeiras-tela": {"parent": "cadeiras", "pattern": "tela|mesh"}, "cadeiras-presidente": {"parent": "cadeiras", "pattern": "presidente|presidencial"}, "cadeiras-giratorias": {"parent": "cadeiras", "pattern": "giratoria", "exclude": "fixa|interlocutor|trapezio|empilhavel"}, "cadeiras-fixas": {"parent": "cadeiras", "pattern": "fixa|interlocutor|trapezio|empilhavel|base em [“\"]?s"}, "cadeiras-diretor": {"parent": "cadeiras", "pattern": "diretor"}, "cadeiras-executivas": {"parent": "cadeiras", "pattern": "executiva"}, "moveis-de-escritorio": {"union": ["mesas", "armarios", "gaveteiros"]}, "mesas": {"categories": ["mesas"], "or_name": "^mesa "}, "armarios": {"categories": ["armarios"], "exclude": "aco"}, "gaveteiros": {"categories": ["gaveteiros"], "exclude": "^mesa "}, "gaveteiros-moveis": {"parent": "gaveteiros", "pattern": "movel|volante|rodizio"}, "moveis-de-aco": {"categories": ["moveis-de-aco"], "or_name": "^armario.*aco"}, "armarios-aco": {"parent": "moveis-de-aco", "pattern": "armario", "exclude": "roupeiro|sapateira"}, "roupeiros-aco": {"parent": "moveis-de-aco", "pattern": "roupeiro", "exclude": "sapateira"}, "estantes-aco": {"parent": "moveis-de-aco", "pattern": "estante"}, "arquivos-aco": {"parent": "moveis-de-aco", "pattern": "arquivo"}}